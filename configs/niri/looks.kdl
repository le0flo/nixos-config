layout {
  gaps 10

  center-focused-column "never"

  preset-column-widths {
    proportion 0.5
    proportion 0.8
    proportion 1.0
  }

  default-column-width { proportion 0.8; }

  focus-ring {
    off
  }

  border {
    on
    width 4
    active-color "#ffc87f"
    inactive-color "#505050"
    urgent-color "#9b0000"
  }
}
