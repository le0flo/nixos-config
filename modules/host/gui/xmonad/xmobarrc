Config { overrideRedirect = False
       , font     = "GoMono Nerd Font Mono 10"
       , bgColor  = "#5f5f5f"
       , fgColor  = "#f8f8f2"
       , position = BottomH 24
       , commands = [ Run Cpu
                        [ "-L", "3"
                        , "-H", "50"
                        , "--high"  , "red"
                        ] 10
                    , Run Memory ["--template", "Mem: <usedratio>%"] 10
                    , Run Date "%a %Y-%m-%d %H:%M:%S" "date" 10
                    , Run XMonadLog
                    ]
       , sepChar  = "%"
       , alignSep = "}{"
       , template = " %XMonadLog% }{ %cpu% | %memory% | %date% "
       }
