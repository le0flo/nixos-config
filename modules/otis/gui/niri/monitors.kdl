output "eDP-1" {
  mode "1920x1080@60"
  position x=0 y=0
  scale 1.0
  transform "normal"

  focus-at-startup

  hot-corners { off; }
}

output "HDMI-A-3" {
  mode "1920x1080@60"
  position x=0 y=0
  scale 1.0
  transform "normal"

  focus-at-startup

  hot-corners { off; }
}

output "Vestel Elektronik Sanayi ve Ticaret A. S. 24W_LCD_TV 0x01010101" {
  mode "1920x1080@60"
  position x=-1920 y=0
  scale 1.0
  transform "normal"

  hot-corners { off; }
}
