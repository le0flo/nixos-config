layout {
  gaps 10

  always-center-single-column
  center-focused-column "never"

  default-column-width { proportion 0.5; }

  preset-column-widths {
    proportion 0.5
    proportion 0.8
    proportion 1.0
  }

  border { on; width 4; }
  focus-ring { off; }
}

prefer-no-csd

hotkey-overlay {
  skip-at-startup
  hide-not-bound
}
